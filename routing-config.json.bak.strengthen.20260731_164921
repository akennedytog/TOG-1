{
  "meta": {
    "canonical": true,
    "version": "2026-07-18.v4",
    "source_of_truth": "routing-config.json",
    "last_updated": "2026-07-31",
    "notes": "Repaired runtime routing: free local Ollama first, OpenRouter cloud fallback. Anthropic temporarily excluded from automatic routing because the API account has insufficient credits."
  },
  "plugins": {
    "entries": {
      "codex": {
        "enabled": true
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "ollama/qwen3-coder:latest",
        "fallback": [
          "ollama/llama3.1:latest",
          "openrouter/openai/gpt-5.6-luna",
          "openrouter/moonshotai/kimi-k3"
        ]
      }
    }
  },
  "routing": {
    "strategy": "cost_first_quality_guarded",
    "task_classes": {
      "quick": {
        "primary": "ollama/llama3.1:latest",
        "fallback": [
          "ollama/qwen3-coder:latest"
        ],
        "use_for": [
          "chat",
          "summaries",
          "drafting",
          "triage",
          "heartbeats",
          "simple Q&A"
        ]
      },
      "standard": {
        "primary": "ollama/qwen3-coder:latest",
        "fallback": [
          "ollama/llama3.1:latest",
          "openrouter/openai/gpt-5.6-luna"
        ],
        "use_for": [
          "routine coding edits",
          "scripts",
          "single-file implementation",
          "terminal tasks"
        ]
      },
      "heavy_coding": {
        "primary": "openrouter/moonshotai/kimi-k3",
        "fallback": [
          "openrouter/openai/gpt-5.6-luna",
          "ollama/qwen3-coder:latest"
        ],
        "use_for": [
          "multi-file refactor",
          "complex debugging",
          "migration",
          "performance or security sensitive code",
          "long-horizon agentic coding tasks"
        ]
      },
      "architecture": {
        "primary": "openrouter/moonshotai/kimi-k3",
        "fallback": [
          "openrouter/openai/gpt-5.6-luna",
          "ollama/qwen3-coder:latest"
        ],
        "use_for": [
          "design tradeoffs",
          "system architecture",
          "nuanced reasoning",
          "edge-case analysis",
          "deep research"
        ]
      }
    },
    "order": [
      {
        "model": "ollama/llama3.1:latest",
        "role": "default_quick_chat",
        "cost": "free"
      },
      {
        "model": "ollama/qwen3-coder:latest",
        "role": "default_local_coding",
        "cost": "free"
      },
      {
        "model": "openrouter/openai/gpt-5.6-luna",
        "role": "cheap_cloud_backup",
        "cost": "$1/$6 per 1M tokens"
      },
      {
        "model": "openrouter/moonshotai/kimi-k3",
        "role": "premium_reasoning_and_coding",
        "cost": "$3/$15 per 1M tokens"
      },
      {
        "model": "anthropic/claude-3-5-sonnet-20241022",
        "role": "premium_backup",
        "cost": "$3/$15 per 1M tokens"
      }
    ],
    "escalation_rules": {
      "max_attempts_per_model": 1,
      "escalate_when": [
        "multi_file_refactor",
        "heavy_coding_needed",
        "repeated_local_failures",
        "production_bug_unclear_root_cause",
        "performance_or_security_sensitive_changes",
        "user_requests_premium_quality"
      ],
      "deescalate_after": [
        "root_cause_identified",
        "complexity_reduced",
        "premium_step_completed"
      ]
    },
    "provider_failover": {
      "paid_chain": [
        "openrouter/openai/gpt-5.6-luna",
        "openrouter/moonshotai/kimi-k3"
      ],
      "openrouter": {
        "enabled": true,
        "requires_env": "OPENROUTER_API_KEY",
        "notes": "Primary cloud provider. Add key to enable kimi-k3 and gpt-5.6-luna routing.",
        "candidates": [
          "openrouter/moonshotai/kimi-k3",
          "openrouter/openai/gpt-5.6-luna"
        ]
      },
      "anthropic": {
        "enabled": false,
        "requires_env": "ANTHROPIC_API_KEY",
        "reason": "Temporarily excluded from auto-routing: API account has insufficient credits as of 2026-07-31."
      }
    }
  },
  "safety": {
    "prefer_minimal_diffs": true,
    "run_tests_after_changes": true,
    "never_send_secrets_to_cloud_models": true,
    "summarize_before_escalation": true,
    "high_cost_mode_enabled": false,
    "exclude_models": [
      "ollama/llama3.1:70b",
      "ollama/kimi-k2.5:cloud",
      "anthropic/claude-3-5-sonnet-20241022",
      "anthropic/claude-sonnet-4-6",
      "openai/gpt-5.3-codex",
      "openai/gpt-5.4-codex"
    ]
  },
  "health_checks": {
    "enabled": true,
    "frequency": "daily",
    "check_models": [
      "ollama/qwen3-coder:latest",
      "ollama/llama3.1:latest"
    ],
    "track_file": "memory/heartbeat-state.json"
  }
}
