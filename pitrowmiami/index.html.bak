    <!-- Pricing -->
    <section class="py-20">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-4xl font-black mb-4 text-center">Simple Pricing</h2>
            <p class="text-gray-400 text-lg mb-12 text-center">We come to you. Setup, operation, and teardown included.</p>
            <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
                <div class="bg-zinc-800/50 rounded-2xl p-8 border border-zinc-700/50 text-center">
