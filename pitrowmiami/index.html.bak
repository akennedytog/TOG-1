    <!-- Perfect For -->
    <section class="py-20 bg-zinc-900/50">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-4xl font-black mb-4 text-center">Perfect For</h2>
            <p class="text-gray-400 text-lg mb-12 text-center">The ultimate entertainment for any event.</p>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-zinc-800/50 rounded-xl p-6 border border-zinc-700/50 text-center">
                    <div class="text-3xl mb-3">🏢</div>
                    <h3 class="font-bold">Corporate Events</h3>
                    <p class="text-gray-400 text-sm mt-2">Team building, client entertainment, trade shows</p>
                </div>
                <div class="bg-zinc-800/50 rounded-xl p-6 border border-zinc-700/50 text-center">
                    <div class="text-3xl mb-3">🚗</div>
                    <h3 class="font-bold">Car Dealerships</h3>
                    <p class="text-gray-400 text-sm mt-2">Launch events, customer appreciation, test drive events</p>
                </div>
                <div class="bg-zinc-800/50 rounded-xl p-6 border border-zinc-700/50 text-center">
                    <div class="text-3xl mb-3">🎉</div>
                    <h3 class="font-bold">Private Parties</h3>
                    <p class="text-gray-400 text-sm mt-2">Birthdays, bachelor parties, celebrations</p>
                </div>
                <div class="bg-zinc-800/50 rounded-xl p-6 border border-zinc-700/50 text-center">
                    <div class="text-3xl mb-3">🏨</div>
                    <h3 class="font-bold">Hotels & Resorts</h3>
