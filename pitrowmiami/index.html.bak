                    </ul>
                    <a href="#book" class="block w-full border border-gray-600 hover:border-white text-white py-3 rounded-full font-semibold transition-all text-center">Book Half Day</a>
                </div>
                <div class="bg-[#e10600]/10 rounded-2xl p-8 border-2 border-[#e10600] text-center relative">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#e10600] text-white text-xs font-bold px-4 py-1 rounded-full">MOST POPULAR</div>
