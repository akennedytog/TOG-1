{
  "id": "template-008",
  "platform": "linkedin",
  "type": "post",
  "dimensions": "1200x627",
  "theme": "professional-insight",
  "name": "LinkedIn Professional Insight Post",
  "description": "LinkedIn article card for thought leadership content",
  "colors": {
    "primary": "#0077B5",
    "secondary": "#0A66C2",
    "accent": "#C9A227",
    "background": "#FFFFFF",
    "text": "#1A1A1A",
    "muted": "#6B7280"
  },
  "fonts": {
    "headline": "Segoe UI Bold",
    "body": "Segoe UI Regular",
    "quote": "Georgia Italic"
  },
  "elements": [
