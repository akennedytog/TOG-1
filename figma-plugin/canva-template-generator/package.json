{
  "name": "canva-template-generator",
  "version": "1.0.0",
  "description": "Figma plugin for generating Canva-compatible templates",
  "main": "dist/code.js",
  "scripts": {
    "build": "npm run build:ui && npm run build:code",
    "build:ui": "esbuild ui/ui.tsx --bundle --outfile=dist/ui.js --target=es2017 --format=iife --global-name=ui",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --target=es2017 --format=iife --global-name=code",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --outfile=dist/cli.js --target=node18",
    "watch": "npm run build -- --watch",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "serve": "http-server dist -p 8080 -c-1",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "figma",
    "plugin",
    "canva",
    "template",
    "generator",
    "design"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "^0.15.0",
    "@figma/plugin-typings": "^1.100.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "http-server": "^14.0.0",
    "jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0"
  }
}
