cat > calendar.js <<'EOF'
// calendar.js (ESM) - Google Calendar OAuth + quick test
import fs from "fs";
import path from "path";
import readline from "readline";
import { google } from "googleapis";

// ---- Config (edit scopes if needed) ----
// Full access to events (create/update/delete):
const SCOPES = ["https://www.googleapis.com/auth/calendar.events"];

// Read-only alternative (safer):
// const SCOPES = ["https://www.googleapis.com/auth/calendar.readonly"];

const TOKEN_PATH = path.resolve(process.cwd(), "token.json");
const CREDENTIALS_PATH = path.resolve(process.cwd(), "credentials.json");

// ---- Main ----
async function main() {
  const credentials = loadCredentials(CREDENTIALS_PATH);
  const oAuth2Client = createOAuthClient(credentials);

  const token = loadToken(TOKEN_PATH);
  if (token) {
    oAuth2Client.setCredentials(token);
  } else {
    await getAccessToken(oAuth2Client, TOKEN_PATH);
  }

  // Smoke test: list next 10 events
  await listNextEvents(oAuth2Client);
}

function loadCredentials(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(
      `Missing credentials.json at: ${filePath}\n` +
        `Make sure you're running this from the folder that contains credentials.json.`
    );
  }

  const raw = fs.readFileSync(filePath, "utf8");
  const parsed = JSON.parse(raw);

  // Google provides either "installed" (desktop) or "web" (web app) credentials
  const creds = parsed.installed ?? parsed.web;
  if (!creds) {
    throw new Error(
      `credentials.json is missing "installed" or "web" OAuth client config.`
    );
  }
  return creds;
}

function createOAuthClient(creds) {
  const { client_secret, client_id, redirect_uris } = creds;

  if (!client_id || !client_secret || !redirect_uris?.length) {
    throw new Error(
      `OAuth client config incomplete. Ensure client_id, client_secret, redirect_uris exist in credentials.json`
    );
  }

  return new google.auth.OAuth2(client_id, client_secret, redirect_uris[0]);
}

function loadToken(tokenPath) {
  if (!fs.existsSync(tokenPath)) return null;

  try {
    const tokenRaw = fs.readFileSync(tokenPath, "utf8");
    return JSON.parse(tokenRaw);
  } catch (e) {
    throw new Error(
      `token.json exists but could not be read/parsed. Delete token.json and re-run.\n` +
        `Path: ${tokenPath}\nError: ${e.message}`
    );
  }
}

function getAccessToken(oAuth2Client, tokenPath) {
  return new Promise((resolve, reject) => {
    const authUrl = oAuth2Client.generateAuthUrl({
      access_type: "offline",
      scope: SCOPES,
      prompt: "consent",
    });

    console.log("\nAuthorize this app by visiting this url:\n");
    console.log(authUrl);
    console.log("\nAfter approving, paste the code here.\n");

    const rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout,
    });

    rl.question("Enter the code from that page here: ", (code) => {
      rl.close();

      oAuth2Client.getToken(code.trim(), (err, token) => {
        if (err) {
          reject(
            new Error(
              `Error retrieving access token: ${err.message}\n` +
                `Common fixes:\n` +
                `- Ensure Google Calendar API is enabled in the same Google Cloud project\n` +
                `- Ensure OAuth consent screen is configured\n` +
                `- If you see redirect_uri_mismatch, create a Desktop OAuth client and download new credentials.json\n`
            )
          );
          return;
        }

        oAuth2Client.setCredentials(token);

        try {
          fs.writeFileSync(tokenPath, JSON.stringify(token, null, 2), "utf8");
          console.log(`\nToken stored to: ${tokenPath}\n`);
        } catch (e) {
          reject(new Error(`Failed to write token.json: ${e.message}`));
          return;
        }

        resolve(token);
      });
    });
  });
}

async function listNextEvents(auth) {
  const calendar = google.calendar({ version: "v3", auth });

  const res = await calendar.events.list({
    calendarId: "primary",
    timeMin: new Date().toISOString(),
    maxResults: 10,
    singleEvents: true,
    orderBy: "startTime",
  });

  const events = res.data.items ?? [];
  if (!events.length) {
    console.log("No upcoming events found.");
    return;
  }

  console.log("\nUpcoming events:");
  for (const e of events) {
    const start = e.start?.dateTime || e.start?.date || "unknown";
    console.log(`- ${start} — ${e.summary || "(no title)"}`);
  }
}

main().catch((err) => {
  console.error("\n❌ calendar.js failed:\n", err.message);
  process.exit(1);
});
EOF// calendar.js (ESM) - Google Calendar OAuth + quick test
import fs from "fs";
import path from "path";
import readline from "readline";
import { google } from "googleapis";

// ---- Config (edit scopes if needed) ----
// Full access to events (create/update/delete):
const SCOPES = ["https://www.googleapis.com/auth/calendar.events"];

// Read-only alternative (safer):
// const SCOPES = ["https://www.googleapis.com/auth/calendar.readonly"];

const TOKEN_PATH = path.resolve(process.cwd(), "token.json");
const CREDENTIALS_PATH = path.resolve(process.cwd(), "credentials.json");

// ---- Main ----
async function main() {
  const credentials = loadCredentials(CREDENTIALS_PATH);
  const oAuth2Client = createOAuthClient(credentials);

  const token = loadToken(TOKEN_PATH);
  if (token) {
    oAuth2Client.setCredentials(token);
  } else {
    await getAccessToken(oAuth2Client, TOKEN_PATH);
  }

  // Smoke test: list next 10 events
  await listNextEvents(oAuth2Client);
}

function loadCredentials(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(
      `Missing credentials.json at: ${filePath}\n` +
        `Make sure you're running this from the folder that contains credentials.json.`
    );
  }

  const raw = fs.readFileSync(filePath, "utf8");
  const parsed = JSON.parse(raw);

  // Google provides either "installed" (desktop) or "web" (web app) credentials
  const creds = parsed.installed ?? parsed.web;
  if (!creds) {
    throw new Error(
      `credentials.json is missing "installed" or "web" OAuth client config.`
    );
  }
  return creds;
}

function createOAuthClient(creds) {
  const { client_secret, client_id, redirect_uris } = creds;

  if (!client_id || !client_secret || !redirect_uris?.length) {
    throw new Error(
      `OAuth client config incomplete. Ensure client_id, client_secret, redirect_uris exist in credentials.json`
    );
  }

  return new google.auth.OAuth2(client_id, client_secret, redirect_uris[0]);
}

function loadToken(tokenPath) {
  if (!fs.existsSync(tokenPath)) return null;

  try {
    const tokenRaw = fs.readFileSync(tokenPath, "utf8");
    return JSON.parse(tokenRaw);
  } catch (e) {
    throw new Error(
      `token.json exists but could not be read/parsed. Delete token.json and re-run.\n` +
        `Path: ${tokenPath}\nError: ${e.message}`
    );
  }
}

function getAccessToken(oAuth2Client, tokenPath) {
  return new Promise((resolve, reject) => {
    const authUrl = oAuth2Client.generateAuthUrl({
      access_type: "offline",
      scope: SCOPES,
      prompt: "consent",
    });

    console.log("\nAuthorize this app by visiting this url:\n");
    console.log(authUrl);
    console.log("\nAfter approving, paste the code here.\n");

    const rl = readline.createInterface({
      input: process.stdin,
      output: process.stdout,
    });

    rl.question("Enter the code from that page here: ", (code) => {
      rl.close();

      oAuth2Client.getToken(code.trim(), (err, token) => {
        if (err) {
          reject(
            new Error(
              `Error retrieving access token: ${err.message}\n` +
                `Common fixes:\n` +
                `- Ensure Google Calendar API is enabled in the same Google Cloud project\n` +
                `- Ensure OAuth consent screen is configured\n` +
                `- If you see redirect_uri_mismatch, create a Desktop OAuth client and download new credentials.json\n`
            )
          );
          return;
        }

        oAuth2Client.setCredentials(token);

        try {
          fs.writeFileSync(tokenPath, JSON.stringify(token, null, 2), "utf8");
          console.log(`\nToken stored to: ${tokenPath}\n`);
        } catch (e) {
          reject(new Error(`Failed to write token.json: ${e.message}`));
          return;
        }

        resolve(token);
      });
    });
  });
}

async function listNextEvents(auth) {
  const calendar = google.calendar({ version: "v3", auth });

  const res = await calendar.events.list({
    calendarId: "primary",
    timeMin: new Date().toISOString(),
    maxResults: 10,
    singleEvents: true,
    orderBy: "startTime",
  });

  const events = res.data.items ?? [];
  if (!events.length) {
    console.log("No upcoming events found.");
    return;
  }

  console.log("\nUpcoming events:");
  for (const e of events) {
    const start = e.start?.dateTime || e.start?.date || "unknown";
    console.log(`- ${start} — ${e.summary || "(no title)"}`);
  }
}

main().catch((err) => {
  console.error("\n❌ calendar.js failed:\n", err.message);
  process.exit(1);
});
