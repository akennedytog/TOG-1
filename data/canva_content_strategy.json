        "pain_point": "Needs professional templates but can't afford custom design",
        "buying_behavior": "Price-conscious, values bundles, needs quick wins",
        "preferred_categories": ["Instagram Stories", "Pinterest Pins", "Client proposal templates"]
      },
      "growing_business_ben": {
        "age": "32-42",
        "occupation": "Startup founder or small business owner",
        "pain_point": "Wants brand consistency without hiring a designer",
        "buying_behavior": "Willing to invest in premium bundles, values time savings",
        "preferred_categories": ["Business cards", "Presentation decks", "Marketing flyers"]
      },
      "creative_entrepreneur_chloe": {
        "age": "25-32",
        "occupation": "Content creator, coach, or digital product seller",
        "pain_point": "Needs Instagram-worthy templates that stand out",
