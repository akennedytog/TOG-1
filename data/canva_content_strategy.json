    "unique_selling_propositions": {
      "main_usp": "Templates that feel custom-designed, not cookie-cutter",
      "differentiators": [
        "Every template includes Canva-native animations and interactivity",
        "Modular designs - swap colors/fonts in one click with pre-set brand kits",
        "Bonus training videos with every purchase showing customization techniques",
