  "content_calendar": {
    "production_schedule": {
      "weekly_output": {
        "templates_per_week": 15,
        "breakdown": {
          "monday": "Design planning & batch prep (2 hours)",
          "tuesday": "Instagram Stories batch (5 templates)",
          "wednesday": "Pinterest Pins batch (4 templates)",
          "thursday": "Business materials (3 templates - cards, flyers, etc.)",
          "friday": "Bundle creation & store listing optimization",
          "weekend": "Optional: Create seasonal/promotional sets"
        }
      },
      "monthly_goals": {
        "templates_created": 60,
        "bundles_released": 8,
        "store_listings_optimized": "review top 20 performers"
      }
    },
    "release_schedule": {
      "tuesday_releases": {
        "reason": "Tuesday 10-11 AM EST - optimal buyer activity",
        "format": "Feature new bundle or collection"
      },
      "friday_mini_drops": {
        "reason": "Weekend browsing, impulse purchases",
        "format": "Smaller themed sets (3-5 templates)"
      },
      "monthly_mega_bundles": {
        "reason": "Higher price point, comprehensive value",
        "format": "20-30 templates around seasonal theme"
      }
    },
    "bundle_strategies": {
      "starter_bundle": {
        "contents": "10 templates, 1 category",
        "price": "$12-15",
        "purpose": "Low barrier entry, build trust"
      },
      "theme_bundle": {
        "contents": "20-25 templates across 2-3 categories",
        "price": "$25-35",
        "purpose": "Cross-category upsell, cohesive brand kit"
      },
      "ultimate_bundle": {
        "contents": "50+ templates, all categories, bonus elements",
        "price": "$67-97",
        "purpose": "High ticket, complete solution"
      },
      "flash_sale": {
        "contents": "Curated selection of 5-8 templates",
        "price": "$5-7 (72 hours only)",
        "purpose": "Create urgency, move inventory"
      }
    }
  },
