  "pricing_strategy": {
    "philosophy": "Value-based pricing with clear tiers for different customer segments",
    "individual_templates": {
      "description": "Single-purpose templates for specific needs",
      "price_range": {
        "etsy": "$4.99 - $9.99",
        "creative_market": "$7.00 - $15.00",
        "own_site": "$9.00 - $19.00"
      },
      "examples": [
        "Instagram Carousel Template Pack (5 slides)",
        "YouTube Thumbnail Set (3 designs)",
        "Client Proposal Template",
        "Wedding Invitation Suite"
      ],
      "sweet_spot": "$7.99 (perceived value + impulse buy threshold)"
    },
    "bundle_pricing": {
      "description": "Curated collections at 30-50% discount vs individual purchase",
      "tiers": [
        {
          "name": "Starter Bundle",
          "contents": "10-15 templates, single niche",
          "price": "$19.99 - $29.99",
          "value_proposition": "Save 40% vs buying individually"
        },
        {
          "name": "Business Bundle",
          "contents": "30-50 templates, full brand suite",
          "price": "$49.99 - $79.99",
          "value_proposition": "Complete brand identity system"
        },
        {
          "name": "Ultimate Collection",
          "contents": "100+ templates, all-access",
          "price": "$99.99 - $149.99",
          "value_proposition": "Everything you need, forever updates"
        }
      ],
      "bundle_strategy": "Anchor with high-value ultimate bundle, push mid-tier business bundle"
    },
    "subscription_model": {
      "description": "Recurring revenue through template membership",
      "options": [
        {
          "tier": "Template Club - Monthly",
          "price": "$9.99/month",
          "includes": [
            "10 new templates monthly",
            "Access to previous 3 months",
            "Basic support"
          ],
          "target": "Individual creators"
        },
        {
          "tier": "Template Club - Annual",
          "price": "$99/year (17% savings)",
          "includes": [
            "All monthly benefits",
            "Full template archive access",
            "Priority support",
            "Bonus quarterly exclusives"
          ],
          "target": "Committed creators, agencies"
        },
        {
          "tier": "Agency License",
          "price": "$29.99/month or $299/year",
          "includes": [
            "Unlimited team usage",
            "White-label rights",
            "All templates + new releases",
            "Priority support + requests"
          ],
          "target": "Marketing agencies, VA's, designers"
        }
      ],
      "platform": "Gumroad or Shopify (Recharge app)",
      "launch_timeline": "Month 6 (after establishing standalone sales)"
    },
    "promotional_pricing": {
      "flash_sales": "25-40% off, quarterly (create urgency)",
      "new_customer_discount": "15% off first purchase with email signup",
      "bundle_exclusive": "Buy 2 bundles, get 3rd 50% off",
      "holiday_campaigns": {
        "black_friday": "50% off sitewide (biggest sale of year)",
        "valentines": "Love-themed bundles 30% off",
        "back_to_school": "Business/student templates 25% off",
        "new_year": "Goal/planner templates special pricing"
      }
    }
  },

