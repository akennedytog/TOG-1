  "executive_summary": {
    "overview": "A digital template business selling premium, customizable Canva templates across multiple platforms. Targeting content creators, small business owners, and marketers who need professional designs without the learning curve.",
    "mission": "Empower creators to produce stunning visuals in minutes, not hours.",
    "unique_value_proposition": "Industry-specific templates with built-in strategy guides, not just pretty designs.",
    "target_audience": {
      "primary": "Content creators, influencers, and social media managers (ages 25-40)",
      "secondary": "Small business owners, coaches, and consultants",
      "tertiary": "Marketing agencies and VA's managing multiple clients"
    }
  },

  "sales_channels": {
