        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Arlo - Research -->
          <div class="card-hover bg-white dark:bg-gray-800 rounded-2xl p-6 border border-gray-200 dark:border-gray-700 relative overflow-hidden group" data-aos="fade-up" data-aos-delay="0">
