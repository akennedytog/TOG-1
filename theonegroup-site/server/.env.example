# ConvertKit API Configuration
# Get your API key from: https://app.kit.com/account_settings/developer
CONVERTKIT_API_KEY=your_api_key_here

# Tag IDs (optional but recommended)
# To find your tag IDs, run: curl -H "Authorization: Bearer YOUR_API_KEY" https://api.kit.com/v4/tags
# Or visit: https://app.kit.com/subscribers
NEWSLETTER_TAG_ID=your_newsletter_tag_id
BETA_TAG_ID=your_beta_tag_id

# Server Configuration
PORT=3000
NODE_ENV=production