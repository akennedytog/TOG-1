---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact The One Group | AI Automation" description="Get in touch for a free AI audit. We'll identify $5,000+ in annual savings for your business.">
  
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-gray-50 via-white to-brand-50/30 dark:from-gray-950 dark:via-gray-950 dark:to-brand-950/20">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-sm font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-widest">Contact</span>
      <h1 class="text-4xl sm:text-5xl font-display font-bold mt-4 mb-4">Let's Build Something</h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        Book a free 30-minute audit call. We'll identify your biggest automation opportunities.
      </p>
    </div>
  </section>
  
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white dark:bg-gray-950">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        
        <!-- Contact Form -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-8">
          <h2 class="text-xl font-bold mb-6">Send Us a Message</h2>
          <form id="contact-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
              <input type="text" name="name" required autocomplete="name" aria-required="true" aria-label="Name" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
              <input type="email" name="email" required autocomplete="email" aria-required="true" aria-label="Email" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Company</label>
              <input type="text" name="company" autocomplete="organization" aria-label="Company" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Phone</label>
              <input type="tel" name="phone" autocomplete="tel" aria-label="Phone" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">How can we help?</label>
              <textarea name="message" rows="4" required aria-required="true" aria-label="How can we help?" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none transition resize-none"></textarea>
            </div>
            <button type="submit" id="submit-btn" class="w-full px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-500 hover:to-accent-500 transition-all duration-200 shadow-lg shadow-brand-500/25">
              Send Message
            </button>
          </form>
          <div id="success" class="hidden text-center py-8">
            <div class="text-4xl mb-3">✅</div>
            <h3 class="text-lg font-bold mb-2">Message sent!</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Thanks for reaching out. Alec will get back to you within 24 hours.</p>
          </div>
        </div>
        
        <!-- Contact Info -->
        <div class="space-y-6">
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 p-8">
            <h2 class="text-xl font-bold mb-6">Contact Info</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Email</p>
                  <a href="mailto:akennedy@theonegroup.info" class="text-sm text-brand-600 dark:text-brand-400 underline underline-offset-2 hover:no-underline">akennedy@theonegroup.info</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Phone</p>
                  <a href="tel:+15024037201" class="text-sm text-brand-600 dark:text-brand-400 underline underline-offset-2 hover:no-underline">(502) 403-7201</a>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-900/30 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Location</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">South Florida</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="bg-gradient-to-br from-brand-50 to-accent-50 dark:from-brand-900/20 dark:to-accent-900/20 rounded-2xl border border-brand-100 dark:border-brand-800 p-8">
            <h3 class="font-bold text-lg mb-3">Free AI Audit</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
              Not sure where to start? Book a free 30-minute discovery call. We'll identify your biggest automation opportunities with clear ROI projections.
            </p>
            <a href="https://calendly.com/akennedy-theonegroup" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-500 hover:to-accent-500 transition-all duration-200 text-sm">
              Book on Calendly
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
        
      </div>
    </div>
  </section>
  
  <script>
    (function() {
      var form = document.getElementById('contact-form');
      var success = document.getElementById('success');
      if (!form) return;
      
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        var button = document.getElementById('submit-btn');
        if (button) { button.disabled = true; button.textContent = 'Sending…'; }
        
        var data = Object.fromEntries(new FormData(form));
        data.form_type = 'contact';
        
        try {
          var response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || 'Submission failed');
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } catch (error) {
          console.error('Contact submission failed:', error);
          alert('We could not send your message right now. Please try again or email us directly at akennedy@theonegroup.info.');
        } finally {
          if (button) { button.disabled = false; button.textContent = 'Send Message'; }
        }
      });
    })();
  </script>
</BaseLayout>
