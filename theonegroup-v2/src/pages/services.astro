---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="AI Services for SMBs | The One Group" 
  description="Full-spectrum AI automation services: audit, implementation, competitor intelligence, and coaching for South Florida businesses."
>
  
  <!-- Hero -->
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-gray-50 via-white to-brand-50/30 dark:from-gray-950 dark:via-gray-950 dark:to-brand-950/20">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-sm font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-widest">Services</span>
      <h1 class="text-4xl sm:text-5xl font-display font-bold mt-4 mb-4">What We Build</h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        Every engagement starts with a free audit. We find the highest-ROI automation opportunities in your business and build custom solutions that deliver measurable results.
      </p>
    </div>
  </section>
  
  <!-- Service Details -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto space-y-32">
      
      <!-- AI Audit -->
      <div id="audit" class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-sm font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-widest">Starting at $2,500</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold mt-3 mb-6">AI Visibility Audit</h2>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-8">
            We analyze your current workflows, identify every task that can be automated, 
            and build a prioritized roadmap. You'll know exactly where AI can save you time and money — before you spend a dollar on implementation.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Full workflow audit across all departments</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">ROI projections for each automation opportunity</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Prioritized implementation roadmap with timelines</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-brand-100 dark:bg-brand-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Executive summary with key findings and recommendations</span>
            </li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-brand-50 to-accent-50 dark:from-brand-900/20 dark:to-accent-900/20 rounded-2xl border border-brand-100 dark:border-brand-800 p-8 lg:p-10">
          <div class="text-center">
            <p class="text-sm font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-widest">One-time investment</p>
            <p class="text-5xl font-bold mt-4 bg-gradient-to-r from-brand-600 to-accent-600 bg-clip-text text-transparent">$2,500</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Includes full report and 30-minute review call</p>
            <div class="mt-8 space-y-3">
              <a href="/contact" class="block w-full text-center px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-500 hover:to-accent-500 transition-all duration-200 shadow-lg shadow-brand-500/25">
                Book Your Audit
              </a>
              <p class="text-xs text-gray-600">No commitment required. Free 15-minute discovery call first.</p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- AI Implementation -->
      <div id="implementation" class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="order-2 lg:order-1 bg-gradient-to-br from-accent-50 to-brand-50 dark:from-accent-900/20 dark:to-brand-900/20 rounded-2xl border border-accent-100 dark:border-accent-800 p-8 lg:p-10">
          <div class="text-center">
            <p class="text-sm font-semibold text-accent-600 dark:text-accent-400 uppercase tracking-widest">Custom Build</p>
            <p class="text-5xl font-bold mt-4 bg-gradient-to-r from-accent-600 to-brand-600 bg-clip-text text-transparent">$2,500&ndash;$10,000</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Depends on scope and complexity</p>
            <div class="mt-8 space-y-3">
              <a href="/contact" class="block w-full text-center px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-accent-600 to-brand-600 hover:from-accent-500 hover:to-brand-500 transition-all duration-200 shadow-lg shadow-accent-500/25">
                Get a Quote
              </a>
              <p class="text-xs text-gray-600">Includes 30 days of post-launch support and optimization</p>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <span class="text-sm font-semibold text-accent-600 dark:text-accent-400 uppercase tracking-widest">Custom Build</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold mt-3 mb-6">AI Agent Implementation</h2>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-8">
            We build custom AI agent swarms that work for your specific business. 
            Lead research, content creation, sales outreach — automated and running 24/7.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Custom agent swarm architecture designed for your business</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Seamless integration with your existing tools and workflows</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Ongoing optimization and support — we don't just build and leave</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-accent-100 dark:bg-accent-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Performance dashboards and monthly reporting</span>
            </li>
          </ul>
        </div>
      </div>
      
      <!-- Competitor Intel -->
      <div id="intelligence" class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-widest">Monthly Subscription</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold mt-3 mb-6">Competitor Intelligence</h2>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-8">
            Ongoing monitoring of your competitive landscape. We track competitors, market shifts, 
            and opportunities — delivered to your inbox weekly so you never miss a move.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Competitor website, social, and content monitoring</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Market trend analysis with actionable alerts</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Weekly email briefings with competitive intel and recommendations</span>
            </li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-emerald-50 to-brand-50 dark:from-emerald-900/20 dark:to-brand-900/20 rounded-2xl border border-emerald-100 dark:border-emerald-800 p-8 lg:p-10">
          <div class="text-center">
            <p class="text-sm font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-widest">Monthly</p>
            <p class="text-5xl font-bold mt-4 bg-gradient-to-r from-emerald-600 to-brand-600 bg-clip-text text-transparent">$297<span class="text-2xl text-gray-400">/mo</span></p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Cancel anytime. No long-term contract.</p>
            <div class="mt-8 space-y-3">
              <a href="/contact" class="block w-full text-center px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-emerald-600 to-brand-600 hover:from-emerald-500 hover:to-brand-500 transition-all duration-200 shadow-lg shadow-emerald-500/25">
                Start Monitoring
              </a>
              <p class="text-xs text-gray-600">First month free with any implementation project</p>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </section>
  
  <!-- AI Coaching -->
      <div id="coaching" class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="order-2 lg:order-1 bg-gradient-to-br from-purple-50 to-brand-50 dark:from-purple-900/20 dark:to-brand-900/20 rounded-2xl border border-purple-100 dark:border-purple-800 p-8 lg:p-10">
          <div class="text-center">
            <p class="text-sm font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-widest">Training &amp; Coaching</p>
            <p class="text-5xl font-bold mt-4 bg-gradient-to-r from-purple-600 to-brand-600 bg-clip-text text-transparent">$1,500&ndash;$7,500</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">Per session or package</p>
            <div class="mt-8 space-y-3">
              <a href="/contact" class="block w-full text-center px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-purple-600 to-brand-600 hover:from-purple-500 hover:to-brand-500 transition-all duration-200 shadow-lg shadow-purple-500/25">
                Book a Session
              </a>
              <p class="text-xs text-gray-600">Team discounts available for groups of 5+</p>
            </div>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <span class="text-sm font-semibold text-purple-600 dark:text-purple-400 uppercase tracking-widest">Training</span>
          <h2 class="text-3xl sm:text-4xl font-display font-bold mt-3 mb-6">AI Coaching &amp; Training</h2>
          <p class="text-gray-500 dark:text-gray-400 leading-relaxed mb-8">
            Hands-on training for your team. We teach your staff how to use AI tools effectively — 
            from prompt engineering to workflow automation to AI strategy.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Custom training sessions tailored to your industry and tools</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Prompt engineering, workflow automation, and AI strategy</span>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm text-gray-600 dark:text-gray-400">Ongoing support and Q&A sessions after training</span>
            </li>
          </ul>
        </div>
      </div>
      
  <!-- CTA -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-display font-bold mb-4">Not Sure What You Need?</h2>
      <p class="text-gray-500 dark:text-gray-400 mb-8">
        Book a free 15-minute discovery call. We'll help you figure out the best path forward — no pressure, no sales pitch.
      </p>
      <a href="/contact" class="inline-flex items-center gap-2.5 px-8 py-4 rounded-xl font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-500 hover:to-accent-500 transition-all duration-200 shadow-lg shadow-brand-500/25 hover:-translate-y-0.5">
        Book a Free Call
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
