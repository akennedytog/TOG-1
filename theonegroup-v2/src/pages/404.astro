---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | The One Group" description="The page you're looking for doesn't exist.">
  <section class="pt-40 pb-24 px-4 sm:px-6 lg:px-8 text-center">
    <div class="max-w-xl mx-auto">
      <p class="text-6xl font-display font-bold gradient-text mb-6">404</p>
      <h1 class="text-3xl font-display font-bold mb-4">Page Not Found</h1>
      <p class="text-gray-600 dark:text-gray-300 mb-8">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white bg-gradient-to-r from-brand-600 to-accent-600 hover:from-brand-500 hover:to-accent-500 transition-all">
          Back to Home
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-gray-700 dark:text-gray-200 border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800 transition-all">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
