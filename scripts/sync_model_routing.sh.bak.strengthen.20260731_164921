#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CANONICAL="$ROOT_DIR/routing-config.json"
V2_OUT="$ROOT_DIR/MODEL_ROUTING_V2.json"
MD_OUT="$ROOT_DIR/MODEL_ROUTING.md"

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required for sync_model_routing.sh" >&2
  exit 1
fi

jq empty "$CANONICAL"

jq '{
  model_routing: {
    canonical_source: "routing-config.json",
    version: .meta.version,
    policy: "Cost first, quality guarded. Use local/low-cost models by default and escalate to premium only for heavy coding or architecture risk.",
    task_classes: .routing.task_classes,
    hard_rules: {
      always_use_full_model_ids: true,
      exclude_auto_routing: .safety.exclude_models,
      max_attempts_per_model: .routing.escalation_rules.max_attempts_per_model,
      deescalate_after_hard_part: true
    },
    provider_failover: {
      paid_chain: .routing.provider_failover.paid_chain,
      openrouter_optional: {
        enabled: .routing.provider_failover.openrouter.enabled,
        requires_env: .routing.provider_failover.openrouter.requires_env
      }
    },
    health: {
      enabled: .health_checks.enabled,
      frequency: .health_checks.frequency,
      check_models: .health_checks.check_models,
      state_file: .health_checks.track_file
    }
  }
}' "$CANONICAL" > "$V2_OUT"

LAST_UPDATED="$(jq -r '.meta.last_updated' "$CANONICAL")"
VERSION="$(jq -r '.meta.version' "$CANONICAL")"
HEAVY_PRIMARY="$(jq -r '.routing.task_classes.heavy_coding.primary' "$CANONICAL")"
ARCH_PRIMARY="$(jq -r '.routing.task_classes.architecture.primary' "$CANONICAL")"
PAID_CHAIN="$(jq -r '.routing.provider_failover.paid_chain[]' "$CANONICAL" | nl -w1 -s'. `')"
EXCLUDED="$(jq -r '.safety.exclude_models[] | "- `" + . + "`"' "$CANONICAL")"
CLOUD_PROVIDER_NOTE="$(jq -r '.routing.provider_failover.openrouter.notes' "$CANONICAL")"

cat > "$MD_OUT" <<MD
# Model Routing & Cost Rules

**Last Updated:** ${LAST_UPDATED}  
**Canonical Source:** \`routing-config.json\`  
**Version:** ${VERSION}

## Core Policy

Use the cheapest reliable model first, but escalate fast when quality risk is high.

- Default to local/low-cost models.
- For heavy coding, use \`${HEAVY_PRIMARY}\`.
- For architecture and nuanced reasoning, use \`${ARCH_PRIMARY}\`.
- Always use full model identifiers.
- Never auto-route to excluded models.

## Canonical Configuration

- All authoritative routing rules live in \`routing-config.json\`.
- \`MODEL_ROUTING_V2.json\` and this file are generated by:
  - \`bash scripts/sync_model_routing.sh\`

## Task Classes

- \`quick\`: low-stakes chat, summaries, drafting
- \`standard\`: routine coding, scripts, single-file edits
- \`heavy_coding\`: refactors, migrations, hard debugging
- \`architecture\`: design decisions, deep reasoning

## Paid Failover Chain

$(sed 's/$/`/' <<<"$PAID_CHAIN")

${CLOUD_PROVIDER_NOTE}

## Excluded From Auto-Routing

${EXCLUDED}

## Health Monitoring

- Daily smoke checks for core models
- Command: \`bash scripts/model_routing_healthcheck.sh\`
- State file: \`memory/heartbeat-state.json\`
MD

echo "Synced: $V2_OUT and $MD_OUT from $CANONICAL"
