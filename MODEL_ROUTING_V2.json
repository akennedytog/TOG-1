{
  "model_routing": {
    "canonical_source": "routing-config.json",
    "version": "5.2",
    "updated": "2026-08-01",
    "policy": "Cost first, quality guarded. Use free Ollama Cloud models by default and escalate through paid fallbacks only when they fail.",
    "stack": {
      "primary": {
        "model": "ollama/deepseek-v4-flash:cloud",
        "cost": "$0 (Ollama Pro prepaid)",
        "context": 512000,
        "use": "all interactive sessions, crons, heartbeats",
        "provider": "ollama",
        "note": "DeepSeek V4 Flash via Ollama Cloud; not OpenRouter"
      },
      "fallback1": {
        "model": "ollama/gpt-oss:20b-cloud",
        "cost": "$0 (Ollama Pro prepaid)",
        "context": 131000,
        "use": "auto‑fallback if primary is down"
      },
      "fallback2": {
        "model": "openrouter/moonshotai/kimi-k3",
        "cost": "$3/$15 per 1M",
        "use": "auto‑fallback when both Ollama models fail"
      },
      "fallback3": {
        "model": "openrouter/openai/gpt-5.6-sol",
        "cost": "$1/$6 per 1M",
        "use": "second paid fallback"
      },
      "utility": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "cost": "$1/$6 per 1M",
        "use": "last‑resort emergency fallback"
      },
      "local_batch": {
        "models": [
          "ollama/llama3.1:latest",
          "ollama/qwen3-coder:latest"
        ],
        "cost": "$0",
        "use": "direct API calls from scripts (Arlo, Iris) — small prompts only"
      }
    },
    "retired": [
      "ollama/kimi-k2.5:cloud",
      "ollama/qwen3-coder:480b-cloud",
      "ollama/glm-4.6:cloud",
      "ollama/minimax-m2:cloud"
    ],
    "health": {
      "enabled": true,
      "frequency": "daily",
      "check_models": [
        "ollama/deepseek-v4-flash:cloud",
        "ollama/gpt-oss:20b-cloud"
      ],
      "cloud_api_models": [
        "openrouter/moonshotai/kimi-k3",
        "openrouter/openai/gpt-5.6-sol",
        "openrouter/openai/gpt-5.6-luna"
      ],
      "state_file": "memory/heartbeat-state.json"
    }
  }
}
