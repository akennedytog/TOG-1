{
  "version": "5.1",
  "updated": "2026-08-01",
  "description": "Ollama-Cloud-first routing with non-Kimi automatic fallbacks.",
  "stack": {
    "primary": {
      "model": "ollama/gpt-oss:120b-cloud",
      "cost": "$0 (Ollama Pro prepaid)",
      "context": 512000,
      "use": "all interactive sessions, crons, heartbeats"
    },
    "fallback1": {
      "model": "ollama/gpt-oss:20b-cloud",
      "cost": "$0 (Ollama Pro prepaid)",
      "context": 131000,
      "use": "auto-fallback if 120b is unavailable"
    },
    "fallback2": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "cost": "$1/$6 per 1M",
      "use": "emergency only if Ollama Cloud is down"
    },
    "local_batch": {
      "models": [
        "ollama/llama3.1:latest",
        "ollama/qwen3-coder:latest"
      ],
      "cost": "$0",
      "use": "direct API calls from scripts (arlo, iris) — small prompts only, NOT gateway sessions"
    },
    "fallback_auto_paid": {
      "model": "openrouter/openai/gpt-4o-mini",
      "cost": "OpenRouter lower-cost emergency fallback",
      "use": "automatic fallback after both Ollama models fail"
    },
    "fallback_paid_backup": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "cost": "$1/$6 per 1M",
      "use": "secondary emergency fallback"
    }
  },
  "retired_2026_07_31": [
    "ollama/kimi-k2.5:cloud",
    "ollama/qwen3-coder:480b-cloud",
    "ollama/glm-4.6:cloud",
    "ollama/minimax-m2:cloud"
  ],
  "notes": [
    "Kimi is excluded from automatic and generated routing. Automatic paid fallbacks are OpenRouter gpt-4o-mini, then gpt-5.6-luna.",
    "Local llama3.1 and qwen3-coder remain for direct batch scripts only, not gateway sessions.",
    "Keep prompts below the selected model context limit; large jobs should be chunked before routing."
  ],
  "health_checks": {
    "check_models": [
      "ollama/gpt-oss:120b-cloud",
      "ollama/gpt-oss:20b-cloud"
    ],
    "cloud_api_models": [
      "openrouter/openai/gpt-4o-mini",
      "openrouter/openai/gpt-5.6-luna"
    ],
    "manual_pin_only": [
      "openrouter/moonshotai/kimi-k3"
    ],
    "enabled": true,
    "frequency": "daily",
    "canary_models": [
      "ollama/gpt-oss:120b-cloud",
      "openrouter/openai/gpt-4o-mini"
    ],
    "balance_alerts": true,
    "track_file": "memory/heartbeat-state.json"
  },
  "meta": {
    "version": "2026-08-01.v5.1",
    "last_updated": "2026-08-01"
  },
  "routing": {
    "task_classes": {
      "quick": {
        "primary": "ollama/gpt-oss:20b-cloud"
      },
      "standard": {
        "primary": "ollama/gpt-oss:120b-cloud"
      },
      "heavy_coding": {
        "primary": "ollama/gpt-oss:120b-cloud"
      },
      "architecture": {
        "primary": "ollama/gpt-oss:120b-cloud"
      }
    },
    "escalation_rules": {
      "max_attempts_per_model": 1,
      "deescalate_after_hard_part": true
    },
    "provider_failover": {
      "paid_chain": [
        "openrouter/openai/gpt-4o-mini",
        "openrouter/openai/gpt-5.6-luna"
      ],
      "openrouter": {
        "enabled": true,
        "requires_env": "OPENROUTER_API_KEY",
        "notes": "Automatic paid fallback only after both Ollama Cloud models fail."
      },
      "openai": {
        "enabled": false,
        "requires_env": "OPENAI_API_KEY",
        "notes": "Direct OpenAI routing disabled; use OpenRouter models instead."
      }
    }
  },
  "safety": {
    "exclude_models": [
      "ollama/kimi-k2.5:cloud",
      "ollama/qwen3-coder:480b-cloud",
      "ollama/glm-4.6:cloud",
      "ollama/minimax-m2:cloud"
    ]
  }
}
