# Business Automation Configuration
# Add these to your main .env file

# === APOLLO.IO ===
# Get API key from: https://www.apollo.io/
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io

# === AHREFS ===
# Get API token from: https://ahrefs.com/api
AHREFS_API_TOKEN=your_ahrefs_token_here
AHREFS_API_PLAN=lite  # Options: lite, standard, advanced, enterprise

# === BIZ REPORTER ===
# Google Analytics (via gog skill - already configured via oauth)
# Stripe (if you have it)
STRIPE_API_KEY=sk_test_your_stripe_key_here  # or sk_live_

# === RESEND (Email Management) ===
# Get API key from: https://resend.com
RESEND_API_KEY=re_your_resend_key_here

# === TODOIST ===
# Get API token from: https://todoist.com/app/settings/integrations
TODOIST_API_TOKEN=your_todoist_token_here

# === PERPLEXITY ===
# Get API key from: https://www.perplexity.ai/settings
PERPLEXITY_API_KEY=pplx-your_perplexity_key_here

# === AI NEWS ORACLE ===
# Uses public API - no key needed

# === BLOGWATCHER ===
# Uses public feeds - no key needed

# === FIRECRAWL ===
# Get API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your_firecrawl_key_here
