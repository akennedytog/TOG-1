---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "F1 Simulator Rental Pricing Miami | Half Day, Full Day & GP Week — Pit Row Miami";
const description = "See Pit Row Miami's F1 simulator rental pricing. Half Day $1,200, Full Day $1,800, F1 GP Week $3,000. Delivery, setup, staffing & teardown included. Book in Miami-Dade, Broward & Palm Beach.";
---

<BaseLayout title={title} description={description}>
  <!-- JSON-LD: OfferCatalog -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "OfferCatalog",
    "name": "Pit Row Miami F1 Simulator Rental Pricing",
    "url": "https://pitrowmiami.com/pricing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Pit Row Miami",
      "email": "info@pitrowmiami.com",
      "telephone": "+19548002162",
      "areaServed": ["Miami-Dade", "Broward", "Palm Beach"]
    },
    "itemListElement": [{
      "@type": "Offer",
      "name": "Half Day F1 Simulator Rental",
      "price": "1200",
      "priceCurrency": "USD",
      "description": "4 hours, two pro Fanatec rigs, delivery, staffing and teardown included."
    }, {
      "@type": "Offer",
      "name": "Full Day F1 Simulator Rental",
      "price": "1800",
      "priceCurrency": "USD",
      "description": "8 hours, two pro Fanatec rigs, custom branding available."
    }, {
      "@type": "Offer",
      "name": "F1 GP Week F1 Simulator Rental",
      "price": "3000",
      "priceCurrency": "USD",
      "description": "Miami Grand Prix premium week package."
    }]
  })} />

  <!-- Hero -->
  <header class="relative overflow-hidden pt-24 md:pt-16">
    <div class="f1-gradient absolute inset-0 opacity-20"></div>
    <div class="speed-lines absolute inset-0"></div>

    <div class="relative max-w-7xl mx-auto px-4 py-10 md:py-16">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="flex-1">
          <div class="inline-block bg-brand-600/20 text-brand-500 text-sm font-semibold px-4 py-1.5 rounded-full mb-6 border border-brand-600/30">Simple, All-Inclusive Pricing</div>
          <h1 class="text-4xl md:text-6xl font-display font-black tracking-tight leading-tight mb-6">
            F1 Simulator Rental<br />
            <span class="text-brand-600">Pricing</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-6 max-w-2xl">
            No hidden fees. No surprise setup charges. Every rental includes delivery, setup, staffing, the leaderboard system, and full teardown.
          </p>
          <p class="text-gray-400 text-lg mb-8 max-w-2xl">
            Two professional Fanatec rigs with 48" widescreens, running Formula 1 2026 on PS5.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/#book" class="btn-primary text-lg px-8 py-4">Book Your Event</a>
            <a href="tel:+19548002162" class="btn-secondary text-lg px-8 py-4">Call (954) 800-2162</a>
          </div>
        </div>
        <div class="flex-shrink-0">
          <picture>
            <source srcset="/hero-image.webp" type="image/webp" />
            <img src="/hero-image.jpg" alt="F1 simulator rental pricing tiers from Pit Row Miami" width="600" height="749" class="w-full max-w-xs md:max-w-sm rounded-2xl shadow-2xl border border-gray-700" loading="eager" fetchpriority="high" />
          </picture>
        </div>
      </div>
    </div>
  </header>

  <!-- Pricing Tiers -->
  <section id="pricing" class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black mb-4 text-center">Rental Packages</h2>
      <p class="text-gray-300 text-lg mb-12 text-center">Every package includes two sims, delivery, staffing, and teardown.</p>
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="card p-8 text-center">
          <h3 class="text-lg font-semibold text-gray-300 mb-2">Half Day</h3>
          <div class="text-4xl font-black mb-1">$1,200</div>
          <div class="text-gray-300 text-sm mb-6">4 hours · 2 sims</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Delivery &amp; setup</li>
            <li class="flex items-start gap-2">✓ Staffed operation</li>
            <li class="flex items-start gap-2">✓ Teardown &amp; pack</li>
            <li class="flex items-start gap-2">✓ Leaderboard system</li>
            <li class="flex items-start gap-2">✓ F1 2026 on PS5</li>
          </ul>
          <a href="/#book" class="block w-full border border-gray-600 hover:border-white text-white py-3 rounded-full font-semibold transition-all text-center">Book Half Day</a>
        </div>
        <div class="bg-brand-600/10 rounded-2xl p-8 border-2 border-brand-600 text-center relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-600 text-white text-xs font-bold px-4 py-1 rounded-full">MOST POPULAR</div>
          <h3 class="text-lg font-semibold text-gray-300 mb-2">Full Day</h3>
          <div class="text-4xl font-black mb-1">$1,800</div>
          <div class="text-gray-300 text-sm mb-6">8 hours · 2 sims</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Delivery &amp; setup</li>
            <li class="flex items-start gap-2">✓ Staffed operation</li>
            <li class="flex items-start gap-2">✓ Teardown &amp; pack</li>
            <li class="flex items-start gap-2">✓ Leaderboard system</li>
            <li class="flex items-start gap-2">✓ Custom branding</li>
            <li class="flex items-start gap-2">✓ F1 2026 on PS5</li>
          </ul>
          <a href="/#book" class="block w-full bg-brand-600 hover:bg-red-700 text-white py-3 rounded-full font-bold transition-all text-center">Book Full Day</a>
        </div>
        <div class="card p-8 text-center">
          <h3 class="text-lg font-semibold text-gray-300 mb-2">F1 GP Week</h3>
          <div class="text-4xl font-black mb-1">$3,000</div>
          <div class="text-gray-300 text-sm mb-6">Miami Grand Prix · Premium</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Full day + setup</li>
            <li class="flex items-start gap-2">✓ Extended hours</li>
            <li class="flex items-start gap-2">✓ Custom leaderboard</li>
            <li class="flex items-start gap-2">✓ Branded photo ops</li>
            <li class="flex items-start gap-2">✓ F1 2026 on PS5</li>
          </ul>
          <a href="/#book" class="block w-full border border-gray-600 hover:border-white text-white py-3 rounded-full font-semibold transition-all text-center">Book GP Week</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-20 bg-carbon-900/50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-black mb-8 text-center">What's Always Included</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <h3 class="font-bold mb-3">🚚 Turnkey Logistics</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li>✓ Delivery to your venue</li>
              <li>✓ Full setup &amp; calibration</li>
              <li>✓ Teardown &amp; packing</li>
              <li>✓ Spotless cleanup</li>
            </ul>
          </div>
          <div class="card p-6">
            <h3 class="font-bold mb-3">👨‍🔧 Professional Staffing</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li>✓ On-site race host</li>
              <li>✓ Live leaderboard</li>
              <li>✓ Guest coaching for beginners</li>
              <li>✓ Equipment oversight all day</li>
            </ul>
          </div>
          <div class="card p-6">
            <h3 class="font-bold mb-3">🏎️ Premium Equipment</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li>✓ Two Fanatec F1 rigs</li>
              <li>✓ 48" widescreens</li>
              <li>✓ Formula 1 2026 on PS5</li>
              <li>✓ Official F1 wheel &amp; pedals</li>
            </ul>
          </div>
          <div class="card p-6">
            <h3 class="font-bold mb-3">🛡️ Peace of Mind</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li>✓ Fully insured ($2M liability)</li>
              <li>✓ No setup fees</li>
              <li>✓ No hidden costs</li>
              <li>✓ 24-hour quote turnaround</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-3xl font-black mb-8 text-center">Pricing FAQ</h2>
      <div class="space-y-4">
        <div class="card p-6">
          <h3 class="font-bold mb-2">Is there a setup fee?</h3>
          <p class="text-gray-300">No. Every price includes delivery, setup, staffing, and teardown. What you see is what you pay.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-bold mb-2">Are there travel fees?</h3>
          <p class="text-gray-300">We service all of Miami-Dade, Broward, and Palm Beach at the listed prices. For venues just outside these areas, contact us for a custom quote.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-bold mb-2">Can I book multiple days?</h3>
          <p class="text-gray-300">Yes. Multi-day launch events and GP-week packages are available — contact us for bundled pricing.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-bold mb-2">How do I confirm a booking?</h3>
          <p class="text-gray-300">Send your date and venue via the booking form, email, or phone. We'll confirm availability and lock in your date within 24 hours.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-bold mb-2">What if I need more than two rigs?</h3>
          <p class="text-gray-300">For larger events, ask about multi-rig options. We can advise on the best setup for your group size.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-carbon-900/50">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-black mb-4">Ready to Book?</h2>
      <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">Tell us your date, venue, and guest count. We'll confirm availability and answer any questions within 24 hours.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/#book" class="btn-primary text-lg px-8 py-4">Book Online</a>
        <a href="mailto:info@pitrowmiami.com" class="btn-secondary text-lg px-8 py-4">Email info@pitrowmiami.com</a>
        <a href="tel:+19548002162" class="btn-secondary text-lg px-8 py-4">Call (954) 800-2162</a>
      </div>
    </div>
  </section>
</BaseLayout>
