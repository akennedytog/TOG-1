---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Pit Row Miami — Premium F1 Simulator Rentals | We Come to You";
const description = "South Florida's premier F1 simulator rental service. Two professional Fanatec rigs with 48\" widescreens, delivered to your event. Corporate events, private parties, and F1 watch parties.";
---

<BaseLayout title={title} description={description}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Pit Row Miami",
    "description": "South Florida premier F1 simulator rental service. Two professional Fanatec rigs delivered to your event.",
    "url": "https://pitrowmiami.com",
    "email": "info@pitrowmiami.com",
    "areaServed": ["Miami-Dade", "Broward", "Palm Beach"],
    "priceRange": "$1,200-$3,000",
    "image": "https://pitrowmiami.com/og-image.jpg"
  })} />

  <!-- Hero -->
  <header class="relative overflow-hidden pt-24 md:pt-16">
    <div class="f1-gradient absolute inset-0 opacity-20"></div>
    <div class="speed-lines absolute inset-0"></div>

    <div class="relative max-w-7xl mx-auto px-4 py-8 md:py-16">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="flex-1">
          <img src="/logo.png" alt="Pit Row Miami" width="1024" height="1024" class="w-40 md:w-56 mb-2" loading="eager" fetchpriority="high" />
          <div class="inline-block bg-brand-600/20 text-brand-500 text-sm font-semibold px-4 py-1.5 rounded-full mb-6 border border-brand-600/30">South Florida's Premier F1 Sim Experience</div>
          <h1 class="text-5xl md:text-7xl font-black tracking-tight leading-tight mb-6">
            We Bring the<br />
            <span class="text-brand-600">Pit Lane</span> to You
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 mb-8 max-w-2xl">
            Two professional Fanatec F1 simulators delivered, set up, and staffed at your event. 
            Head-to-head racing on 48" widescreens. From <span class="text-white font-bold">$1,200/day</span>.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#book" class="btn-primary text-lg px-8 py-4">Book Your Event</a>
            <a href="#details" class="btn-secondary text-lg px-8 py-4">See Details</a>
          </div>
        </div>
        <div class="flex-shrink-0">
          <picture>
            <source srcset="/hero-image.webp" type="image/webp" />
            <img src="/hero-image.jpg" alt="F1 racing simulator setup" width="600" height="800" class="w-full max-w-xs md:max-w-sm rounded-2xl shadow-2xl border border-gray-700" loading="eager" fetchpriority="high" />
          </picture>
        </div>
      </div>
    </div>
  </header>

  <!-- Stats -->
  <section class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-3xl font-black text-brand-600">2</div>
        <div class="text-gray-300 text-sm mt-1">Pro Simulators</div>
      </div>
      <div>
        <div class="text-3xl font-black text-brand-600">48"</div>
        <div class="text-gray-300 text-sm mt-1">Widescreen Each</div>
      </div>
      <div>
        <div class="text-3xl font-black text-brand-600">Formula 1 2026</div>
        <div class="text-gray-300 text-sm mt-1">Latest Official Game</div>
      </div>
      <div>
        <div class="text-3xl font-black text-brand-600">$0</div>
        <div class="text-gray-300 text-sm mt-1">Setup Fee</div>
      </div>
    </div>
  </section>

  <!-- The Experience -->
  <section id="details" class="py-20 bg-carbon-900/50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-black mb-4">The Experience</h2>
      <p class="text-gray-300 text-lg mb-12 max-w-2xl">Everything you need for an unforgettable racing experience at your event.</p>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="card p-8">
          <div class="text-4xl mb-4">🏎️</div>
          <h3 class="text-xl font-bold mb-3">Fanatec F1 Rigs</h3>
          <p class="text-gray-300">Brand new Fanatec systems with the official F1 wheel, pedals, and cockpit. The same gear the pros use — $8K per setup.</p>
        </div>
        <div class="card p-8">
          <div class="text-4xl mb-4">🖥️</div>
          <h3 class="text-xl font-bold mb-3">48" Widescreens</h3>
          <p class="text-gray-300">Immersive ultrawide displays running Formula 1 2026 on PS5. Every turn, every straight — feels like you're in the car.</p>
        </div>
        <div class="card p-8">
          <div class="text-4xl mb-4">🏁</div>
          <h3 class="text-xl font-bold mb-3">Head-to-Head Racing</h3>
          <p class="text-gray-300">Two rigs side by side. Your guests compete for fastest lap. Leaderboard keeps the competition alive all night.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-black mb-4 text-center">Simple Pricing</h2>
      <p class="text-gray-300 text-lg mb-12 text-center">We come to you. Setup, operation, and teardown included.</p>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="card p-8 text-center">
          <h3 class="text-lg font-semibold text-gray-300 mb-2">Half Day</h3>
          <div class="text-4xl font-black mb-1">$1,200</div>
          <div class="text-gray-300 text-sm mb-6">4 hours · 2 sims</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Delivery &amp; setup</li>
            <li class="flex items-start gap-2">✓ Staffed operation</li>
            <li class="flex items-start gap-2">✓ Teardown &amp; pack</li>
            <li class="flex items-start gap-2">✓ Leaderboard system</li>
          </ul>
          <a href="#book" class="block w-full border border-gray-600 hover:border-white text-white py-3 rounded-full font-semibold transition-all text-center">Book Half Day</a>
        </div>
        <div class="bg-brand-600/10 rounded-2xl p-8 border-2 border-brand-600 text-center relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-600 text-white text-xs font-bold px-4 py-1 rounded-full">MOST POPULAR</div>
          <h3 class="text-lg font-semibold text-gray-300 mb-2">Full Day</h3>
          <div class="text-4xl font-black mb-1">$1,800</div>
          <div class="text-gray-300 text-sm mb-6">8 hours · 2 sims</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Delivery &amp; setup</li>
            <li class="flex items-start gap-2">✓ Staffed operation</li>
            <li class="flex items-start gap-2">✓ Teardown &amp; pack</li>
            <li class="flex items-start gap-2">✓ Leaderboard system</li>
            <li class="flex items-start gap-2">✓ Custom branding</li>
          </ul>
          <a href="#book" class="block w-full bg-brand-600 hover:bg-red-700 text-white py-3 rounded-full font-bold transition-all text-center">Book Full Day</a>
        </div>
        <div class="card p-8 text-center">
          <h3 class="text-lg font-semibold text-gray-300 mb-2">F1 GP Week</h3>
          <div class="text-4xl font-black mb-1">$3,000</div>
          <div class="text-gray-300 text-sm mb-6">Miami Grand Prix · Premium</div>
          <ul class="text-left text-gray-300 space-y-3 mb-8">
            <li class="flex items-start gap-2">✓ Full day + setup</li>
            <li class="flex items-start gap-2">✓ Extended hours</li>
            <li class="flex items-start gap-2">✓ Custom leaderboard</li>
            <li class="flex items-start gap-2">✓ Branded photo ops</li>
          </ul>
          <a href="#book" class="block w-full border border-gray-600 hover:border-white text-white py-3 rounded-full font-semibold transition-all text-center">Book GP Week</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Perfect For -->
  <section id="perfect-for" class="py-20 bg-carbon-900/50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-black mb-4 text-center">Perfect For</h2>
      <p class="text-gray-300 text-lg mb-12 text-center">The ultimate entertainment for any event.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card p-6 text-center">
          <div class="text-3xl mb-3">🏢</div>
          <h3 class="font-bold">Corporate Events</h3>
          <p class="text-gray-300 text-sm mt-2">Team building, client entertainment, trade shows</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl mb-3">🚗</div>
          <h3 class="font-bold">Car Dealerships</h3>
          <p class="text-gray-300 text-sm mt-2">Launch events, customer appreciation, test drive events</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl mb-3">🎉</div>
          <h3 class="font-bold">Private Parties</h3>
          <p class="text-gray-300 text-sm mt-2">Birthdays, bachelor parties, celebrations</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl mb-3">🏨</div>
          <h3 class="font-bold">Hotels &amp; Resorts</h3>
          <p class="text-gray-300 text-sm mt-2">Guest activations, weekend events, F1 watch parties</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-black mb-4 text-center">Who We Are</h2>
        <p class="text-gray-300 text-lg mb-8 text-center max-w-2xl mx-auto">South Florida's premium F1 simulator experience — delivered to you.</p>
        <div class="grid md:grid-cols-2 gap-8">
          <div class="card p-8">
            <h3 class="text-xl font-bold mb-4">The Story</h3>
            <p class="text-gray-300 mb-4">Pit Row Miami was born from a simple idea: bring the thrill of Formula 1 racing to any event in South Florida. No track required.</p>
            <p class="text-gray-300 mb-4">We invested in two brand new Fanatec F1 simulator rigs — the same equipment used by professional drivers — paired with 48" widescreens and the latest F1 26 game on PS5.</p>
            <p class="text-gray-300">Every booking includes professional setup, staffed operation, and full teardown. We handle everything so you can focus on your guests.</p>
          </div>
          <div class="card p-8">
            <h3 class="text-xl font-bold mb-4">Why Choose Us</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <span class="text-brand-500 font-bold mt-0.5">✓</span>
                <div><span class="font-semibold">Brand New Equipment</span><br /><span class="text-gray-300 text-sm">$8K Fanatec rigs, fresh out of the box</span></div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-500 font-bold mt-0.5">✓</span>
                <div><span class="font-semibold">Fully Insured</span><br /><span class="text-gray-300 text-sm">$2M general liability coverage</span></div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-500 font-bold mt-0.5">✓</span>
                <div><span class="font-semibold">Professional Staff</span><br /><span class="text-gray-300 text-sm">Experienced operators manage everything</span></div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-500 font-bold mt-0.5">✓</span>
                <div><span class="font-semibold">No Sim Experience Needed</span><br /><span class="text-gray-300 text-sm">F1 26 is casual-friendly, anyone can race</span></div>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-brand-500 font-bold mt-0.5">✓</span>
                <div><span class="font-semibold">We Come to You</span><br /><span class="text-gray-300 text-sm">Miami-Dade, Broward, Palm Beach</span></div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery & Testimonials -->
  <section id="gallery" class="py-20 bg-carbon-900/50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-4xl font-black mb-4 text-center">Moments from the Track</h2>
      <p class="text-gray-300 text-lg mb-12 text-center">Photos and stories from our events around South Florida.</p>
      
      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <div class="card overflow-hidden">
          <div class="aspect-[4/3] bg-carbon-800 flex items-center justify-center relative">
            <img src="/hero-image.webp" alt="F1 racing simulator setup at corporate event" width="600" height="800" class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute text-gray-400 text-sm bg-black/60 px-3 py-1 rounded-full">📸 Photo Coming Soon</span>
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-300">Corporate team-building event</p>
          </div>
        </div>
        <div class="card overflow-hidden">
          <div class="aspect-[4/3] bg-carbon-800 flex items-center justify-center relative">
            <img src="/hero-image.webp" alt="F1 racing simulator at car dealership launch event" width="600" height="800" class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute text-gray-400 text-sm bg-black/60 px-3 py-1 rounded-full">📸 Photo Coming Soon</span>
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-300">Car dealership launch event</p>
          </div>
        </div>
        <div class="card overflow-hidden">
          <div class="aspect-[4/3] bg-carbon-800 flex items-center justify-center relative">
            <img src="/hero-image.webp" alt="F1 racing simulator at private party" width="600" height="800" class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute text-gray-400 text-sm bg-black/60 px-3 py-1 rounded-full">📸 Photo Coming Soon</span>
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-300">Private party head-to-head</p>
          </div>
        </div>
      </div>
      
      <!-- Testimonials -->
      <h3 class="text-2xl font-bold mb-8 text-center">What Our Clients Say</h3>
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="card p-6">
          <div class="flex items-center gap-1 text-brand-500 mb-3">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="text-gray-300 mb-4 italic">"The simulators were a huge hit at our corporate event. Everyone from the CEO to the interns was competing for fastest lap. Will definitely book again."</p>
          <p class="text-sm text-gray-400">— Coming soon, first review</p>
        </div>
        <div class="card p-6">
          <div class="flex items-center gap-1 text-brand-500 mb-3">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="text-gray-300 mb-4 italic">"Setup was seamless and the staff was professional. Our guests loved the head-to-head racing. Added so much energy to the event."</p>
          <p class="text-sm text-gray-400">— Coming soon, first review</p>
        </div>
      </div>
      
      <div class="text-center mt-8">
        <p class="text-gray-300 text-sm">Have photos from your event? <a href="mailto:info@pitrowmiami.com" class="text-brand-500 underline hover:underline">Send them to us</a> and we'll feature them here!</p>
      </div>
    </div>
  </section>

  <!-- Booking Form -->
  <section id="book" class="py-20">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-4xl font-black mb-4 text-center">Book Your Event</h2>
      <p class="text-gray-300 text-lg mb-8 text-center">Fill out the form and we'll reach out to confirm your date. Prefer to talk? Call or text <a href="tel:+19548002162" class="text-brand-500 underline hover:underline">(954) 800-2162</a>.</p>
      <div class="card p-8">
        <form id="booking-form" class="space-y-6" method="POST" action="/api/book">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-name">Name *</label>
              <input type="text" name="name" required id="bk-name" autocomplete="name" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="Your name" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-email">Email *</label>
              <input type="email" name="email" required id="bk-email" autocomplete="email" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="you@email.com" />
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-phone">Phone *</label>
              <input type="tel" name="phone" required id="bk-phone" autocomplete="tel" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="(555) 123-4567" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-event-type">Event Type</label>
              <select name="event_type" id="bk-event-type" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600">
                <option value="">Select one</option>
                <option value="corporate">Corporate Event</option>
                <option value="private">Private Party</option>
                <option value="dealership">Car Dealership</option>
                <option value="hotel">Hotel / Resort</option>
                <option value="watch-party">F1 Watch Party</option>
                <option value="other">Other</option>
              </select>
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-date">Preferred Date *</label>
              <input type="date" name="event_date" required id="bk-date" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-time">Preferred Time</label>
              <input type="time" name="event_time" id="bk-time" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600" />
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-guests">Estimated Guests</label>
              <input type="number" name="guests" min="1" id="bk-guests" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="How many people?" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-location">Location</label>
              <input type="text" name="location" id="bk-location" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="City or venue" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300" for="bk-message">Anything else?</label>
            <textarea name="message" rows="3" id="bk-message" class="w-full rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" placeholder="Special requests, questions, etc."></textarea>
          </div>

          <!-- Honeypot -->
          <div aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden;">
            <label for="website">Website</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="w-full bg-brand-600 hover:bg-red-700 text-white font-bold py-4 rounded-lg transition text-lg">Send Booking Request →</button>
        </form>

        <div id="success" class="hidden text-center py-10">
          <div class="text-5xl mb-4">🏁</div>
          <h2 class="text-2xl font-bold mb-3">Request Sent!</h2>
          <p class="text-gray-300">Thanks! We'll review your request and reach out to confirm your booking within 24 hours.</p>
          <p class="text-gray-300 text-sm mt-4">In the meantime, email us at <a href="mailto:info@pitrowmiami.com" class="text-brand-500 underline hover:underline">info@pitrowmiami.com</a> or call/text <a href="tel:+19548002162" class="text-brand-500 underline hover:underline">(954) 800-2162</a>.</p>
        </div>

        <div id="error" class="hidden text-center py-10">
          <div class="text-5xl mb-4">⚠️</div>
          <h2 class="text-2xl font-bold mb-3">Something went wrong</h2>
          <p id="error-message" class="text-gray-300">Please try again or email us directly.</p>
          <p class="text-gray-300 text-sm mt-4"><a href="mailto:info@pitrowmiami.com" class="text-brand-500 underline hover:underline">info@pitrowmiami.com</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter + Booking Form Handlers -->
  <script>
    // Booking form handler
    (function () {
      var form = document.getElementById('booking-form');
      if (!form) return;
      var success = document.getElementById('success');
      var error = document.getElementById('error');
      var errorMsg = document.getElementById('error-message');

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var button = form.querySelector('button[type="submit"]');
        if (button) { button.disabled = true; button.textContent = 'Sending…'; }

        var data = Object.fromEntries(new FormData(form));
        data.form_type = 'booking';

        try {
          var response = await fetch('/api/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message || 'Submission failed');
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } catch (err) {
          form.classList.add('hidden');
          errorMsg.textContent = err.message || 'Please try again or email us directly.';
          error.classList.remove('hidden');
        }
      });
    })();
  </script>

  <!-- Newsletter -->
  <section class="py-20 bg-carbon-900/50 border-t border-carbon-800">
    <div class="max-w-lg mx-auto px-4 text-center">
      <h2 class="text-3xl font-black mb-2">Stay in the Loop</h2>
      <p class="text-gray-300 text-sm mb-4">Get notified about special rates, availability, and F1 Miami GP updates.</p>
      <form id="newsletter-form" class="flex gap-2 max-w-md mx-auto" method="POST" action="/api/book">
        <input type="email" name="email" required aria-label="Email address" id="nl-email" placeholder="your@email.com" class="flex-1 rounded-lg border border-carbon-600 bg-carbon-900 px-4 py-2.5 text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-600 placeholder-gray-500" />
        <button type="submit" class="bg-brand-600 hover:bg-red-700 text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-all whitespace-nowrap">Subscribe</button>
      </form>
      <p id="newsletter-success" class="hidden text-green-400 text-sm mt-2">Thanks! We'll keep you posted.</p>
      <p id="newsletter-error" class="hidden text-red-400 text-sm mt-2">Something went wrong. Try again or email us.</p>
    </div>
  </section>

  <script>
    // Newsletter form handler
    (function () {
      var form = document.getElementById('newsletter-form');
      if (!form) return;
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var email = form.querySelector('input[name="email"]').value;
        var success = document.getElementById('newsletter-success');
        var error = document.getElementById('newsletter-error');
        var button = form.querySelector('button');
        if (button) { button.disabled = true; button.textContent = 'Subscribing...'; }
        try {
          var response = await fetch('/api/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, form_type: 'newsletter' })
          });
          var result = await response.json();
          if (!response.ok || !result.success) throw new Error('Failed');
          form.classList.add('hidden');
          success.classList.remove('hidden');
        } catch (err) {
          form.classList.add('hidden');
          error.classList.remove('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
