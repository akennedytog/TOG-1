---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Privacy Policy — Pit Row Miami";
const description = "Privacy policy for Pit Row Miami F1 simulator rental services.";
---

<BaseLayout title={title} description={description}>
  <section class="pt-32 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <a href="/" class="text-brand-500 underline hover:underline mb-8 inline-block">&larr; Back to Pit Row Miami</a>
      <h1 class="text-4xl font-black mb-8">Privacy Policy</h1>
      <div class="space-y-6 text-gray-300 leading-relaxed">
        <p><strong class="text-white">Last updated:</strong> August 8, 2026</p>

        <h2 class="text-2xl font-bold text-white mt-8">Information We Collect</h2>
        <p>When you submit a booking inquiry through our website, we collect your name, email address, phone number, event details, and any additional information you provide in your message.</p>

        <h2 class="text-2xl font-bold text-white mt-8">How We Use Your Information</h2>
        <p>We use your information solely to respond to your booking inquiry, communicate about your event, and provide our F1 simulator rental services. We do not sell, share, or distribute your personal information to third parties.</p>

        <h2 class="text-2xl font-bold text-white mt-8">Data Retention</h2>
        <p>We retain your contact information for the duration of our business relationship and for a reasonable period thereafter for record-keeping purposes. You may request deletion of your data at any time by contacting us at info@pitrowmiami.com.</p>

        <h2 class="text-2xl font-bold text-white mt-8">Cookies &amp; Analytics</h2>
        <p>We use cookies and Google Analytics to understand how visitors use our site. Analytics only load after you provide consent via our cookie banner. You can withdraw consent at any time by clearing your browser's local storage. We do not sell your data.</p>

        <h2 class="text-2xl font-bold text-white mt-8">Contact</h2>
        <p>For questions about this policy, contact us at <a href="mailto:info@pitrowmiami.com" class="text-brand-500 underline hover:underline">info@pitrowmiami.com</a>.</p>
        <p class="pt-4"><a href="/terms" class="text-brand-500 underline hover:underline">View our Terms of Service</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
