---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  date: string;
  readTime: string;
}

const { title, description, date, readTime } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://pitrowmiami.com').toString();
---

<BaseLayout title={title} description={description}>
  <div class="bg-black text-white pt-28 pb-20 px-4 sm:px-6 lg:px-8">
    <article class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="text-sm text-carbon-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-500 transition-colors">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog" class="hover:text-brand-500 transition-colors">Blog</a>
        <span class="mx-2">/</span>
        <span class="text-carbon-300">Article</span>
      </nav>

      <!-- Title block -->
      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-display font-black text-white mb-4 leading-tight">{title}</h1>
        <div class="flex items-center gap-4 text-sm text-carbon-400">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            {date}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {readTime} min read
          </span>
          <span class="text-brand-500 font-semibold">Pit Row Miami</span>
        </div>
      </header>

      <!-- Body -->
      <div class="blog-body">
        <slot />
      </div>

      <!-- Author CTA -->
      <div class="mt-14 p-6 sm:p-8 rounded-2xl f1-gradient border border-carbon-800">
        <p class="font-display font-bold text-white text-lg mb-1">Ready to bring the track to your event?</p>
        <p class="text-carbon-200 text-sm mb-5">Tell us your date, venue, and guest count — we'll send a custom quote and check availability.</p>
        <a href="mailto:info@pitrowmiami.com" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm whitespace-nowrap transition-colors">
          Email info@pitrowmiami.com
        </a>
      </div>

      <!-- Related posts -->
      <div class="mt-12">
        <h2 class="font-display font-bold text-white mb-4 text-lg">More from the Pit Row blog</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <a href="/blog/racing-simulator-party-rental-miami" class="card p-5 block hover:border-brand-500/50">
            <span class="text-xs font-bold text-brand-500 uppercase tracking-wider">Events</span>
            <p class="text-white font-semibold mt-1 text-sm leading-snug">Racing Simulator Party Rental in Miami: The Ultimate Event Upgrade</p>
          </a>
          <a href="/blog/corporate-team-building-events-miami" class="card p-5 block hover:border-brand-500/50">
            <span class="text-xs font-bold text-brand-500 uppercase tracking-wider">Corporate</span>
            <p class="text-white font-semibold mt-1 text-sm leading-snug">Corporate Team Building Events in Miami: Why F1 Sim Racing Wins</p>
          </a>
          <a href="/blog/f1-race-watch-party-miami" class="card p-5 block hover:border-brand-500/50">
            <span class="text-xs font-bold text-brand-500 uppercase tracking-wider">Race Day</span>
            <p class="text-white font-semibold mt-1 text-sm leading-snug">F1 Race Watch Party Miami: Race Between Sessions, Watch the Grand Prix</p>
          </a>
          <a href="/blog/racing-simulator-bachelor-party-miami" class="card p-5 block hover:border-brand-500/50">
            <span class="text-xs font-bold text-brand-500 uppercase tracking-wider">Bachelor Party</span>
            <p class="text-white font-semibold mt-1 text-sm leading-snug">Racing Simulator for Bachelor Party Miami: Pro-Level Rigs &amp; How It Works</p>
          </a>
        </div>
      </div>
    </article>
  </div>

  <!-- Structured Data: BlogPosting -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": date,
    "author": { "@type": "Organization", "name": "Pit Row Miami" },
    "publisher": { "@type": "Organization", "name": "Pit Row Miami" },
    "mainEntityOfPage": canonical,
    "image": "https://pitrowmiami.com/og-image.jpg"
  })} />
</BaseLayout>

<style is:global>
  .blog-body {
    color: #d1d1d1;
    line-height: 1.75;
    font-size: 1.0625rem;
  }
  .blog-body h2 {
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .blog-body h3 {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.2rem;
    margin: 1.5rem 0 0.5rem;
  }
  .blog-body p {
    margin: 0 0 1.1rem;
  }
  .blog-body ul, .blog-body ol {
    margin: 0 0 1.25rem 1.25rem;
  }
  .blog-body ul { list-style: disc; }
  .blog-body ol { list-style: decimal; }
  .blog-body li {
    margin: 0.35rem 0;
  }
  .blog-body li::marker {
    color: #e10600;
  }
  .blog-body strong {
    color: #ffffff;
    font-weight: 600;
  }
  .blog-body a {
    color: #ff5f5a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-body a:hover {
    color: #ff2a20;
  }
  .blog-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .blog-body th, .blog-body td {
    border: 1px solid #2b2b2b;
    padding: 0.6rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }
  .blog-body th {
    background-color: #181818;
    color: #ffffff;
    font-weight: 600;
  }
  .blog-body tr:nth-child(even) td {
    background-color: #181818;
  }
  @media (max-width: 640px) {
    .blog-body { font-size: 1rem; }
    .blog-body h2 { font-size: 1.3rem; }
  }
</style>
