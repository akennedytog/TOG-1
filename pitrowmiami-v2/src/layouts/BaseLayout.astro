---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.jpg' } = Astro.props;
const GA_ID = 'G-B5NV9GJ810';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="author" content="Pit Row Miami" />
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    
    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    
    <!-- Fonts (async, non-render-blocking) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" /></noscript>
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).toString()} />
    <meta property="og:site_name" content="Pit Row Miami" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url).toString()} />
    
    <!-- Canonical -->
    <link rel="canonical" href={Astro.url} />
    
    <title>{title}</title>
    
    <!-- Consent-gated analytics loader: GA only loads after explicit opt-in -->
    <script>
      // Consent state: localStorage 'prm-consent' = 'accepted' | 'declined' | null
      window.prmConsent = (function () {
        try { return localStorage.getItem('prm-consent'); } catch (e) { return null; }
      })();

      function loadAnalytics() {
        if (window.prmConsent !== 'accepted') return;
        if (window.gtag || document.getElementById('gtag-script')) return;
        var s = document.createElement('script');
        s.id = 'gtag-script';
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.__GA_ID;
        s.onload = function () {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', window.__GA_ID);
        };
        document.head.appendChild(s);
      }
      window.__GA_ID = '{GA_ID}';
      window.loadAnalytics = loadAnalytics;
      window.gtagConsent = function (accepted) {
        if (accepted) {
          window.prmConsent = 'accepted';
          loadAnalytics();
        }
      };

      // Returning visitor who already accepted: load analytics
      if (window.prmConsent === 'accepted') {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', loadAnalytics);
        } else {
          loadAnalytics();
        }
      }
    </script>

    <!-- Structured Data: Organization + LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Pit Row Miami",
      "description": "Premium F1 simulator rental service in South Florida. Two professional Fanatec rigs delivered to corporate events, parties, and team building.",
      "url": "https://pitrowmiami.com/",
      "logo": "https://pitrowmiami.com/favicon.png",
      "image": "https://pitrowmiami.com/og-image.jpg",
      "email": "info@pitrowmiami.com",
      "areaServed": "South Florida, Miami, United States",
      "priceRange": "$$",
      "sameAs": []
    }
    </script>
  </head>
  <body class="bg-black text-white">
    <!-- Skip to content -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:rounded-lg">Skip to main content</a>
    
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-xl border-b border-carbon-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center gap-2">
            <span class="font-black text-xl tracking-tight">PIT ROW <span class="text-brand-500">MIAMI</span></span>
          </a>
          
          <!-- Desktop Nav -->
          <div class="hidden md:flex items-center gap-8">
            <a href="/#details" class="text-sm font-medium text-gray-300 hover:text-brand-500 transition-colors" aria-label="The Experience">The Experience</a>
            <a href="/#pricing" class="text-sm font-medium text-gray-300 hover:text-brand-500 transition-colors" aria-label="Pricing">Pricing</a>
            <a href="/#perfect-for" class="text-sm font-medium text-gray-300 hover:text-brand-500 transition-colors" aria-label="Perfect For">Perfect For</a>
            <a href="/#gallery" class="text-sm font-medium text-gray-300 hover:text-brand-500 transition-colors" aria-label="Gallery">Gallery</a>
            <a href="/blog" class="text-sm font-medium text-gray-300 hover:text-brand-500 transition-colors" aria-label="Blog">Blog</a>
            <a href="/#book" class="btn-primary text-sm px-5 py-2.5">Book Your Event</a>
          </div>
          
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="md:hidden p-2 text-gray-300 hover:text-brand-500" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        
        <!-- Mobile Nav -->
        <div id="mobile-menu" class="hidden md:hidden pb-6" aria-label="Primary navigation">
          <div class="flex flex-col gap-2">
            <a href="/#details" class="px-4 py-2.5 rounded-lg text-gray-300 hover:bg-carbon-800 transition-colors">The Experience</a>
            <a href="/#pricing" class="px-4 py-2.5 rounded-lg text-gray-300 hover:bg-carbon-800 transition-colors">Pricing</a>
            <a href="/#perfect-for" class="px-4 py-2.5 rounded-lg text-gray-300 hover:bg-carbon-800 transition-colors">Perfect For</a>
            <a href="/#gallery" class="px-4 py-2.5 rounded-lg text-gray-300 hover:bg-carbon-800 transition-colors">Gallery</a>
            <a href="/blog" class="px-4 py-2.5 rounded-lg text-gray-300 hover:bg-carbon-800 transition-colors">Blog</a>
            <a href="/#book" class="btn-primary text-sm px-5 py-2.5 text-center mt-2">Book Your Event</a>
          </div>
        </div>
      </div>
    </nav>
    
    <main id="main-content">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-carbon-950 border-t border-carbon-800 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="flex flex-col gap-2">
            <span class="text-lg font-black tracking-tight">PIT ROW <span class="text-brand-500">MIAMI</span></span>
            <div class="flex items-center gap-3 text-sm">
              <a href="/blog" class="text-gray-400 hover:text-white text-sm transition underline underline-offset-2">Blog</a>
              <span class="text-gray-600">·</span>
              <a href="/privacy" class="text-gray-400 hover:text-white text-sm transition underline underline-offset-2">Privacy Policy</a>
              <span class="text-gray-600">·</span>
              <a href="/terms" class="text-gray-400 hover:text-white text-sm transition underline underline-offset-2">Terms of Service</a>
            </div>
            <a href="mailto:info@pitrowmiami.com" class="text-sm text-gray-400 hover:text-white transition">info@pitrowmiami.com</a>
            <a href="tel:+19548002162" class="text-sm text-gray-400 hover:text-white transition">(954) 800-2162</a>
          </div>
          <div class="text-sm text-gray-400">
            <p class="font-semibold text-gray-300">Miami-Dade · Broward · Palm Beach</p>
            <p>pitrowmiami.com</p>
          </div>
        </div>
        <div class="text-center mt-8 pt-6 border-t border-carbon-800 text-sm text-gray-400">
          &copy; {new Date().getFullYear()} Pit Row Miami. All rights reserved.
        </div>
      </div>
    </footer>
    
    <!-- Mobile menu toggle -->
    <script>
      (function () {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;
        function setMenu(open) {
          menu.classList.toggle('hidden', !open);
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          if (open) {
            var firstLink = menu.querySelector('a');
            if (firstLink) firstLink.focus();
          } else {
            btn.focus();
          }
        }
        btn.addEventListener('click', function () {
          var open = menu.classList.contains('hidden');
          setMenu(open);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
            setMenu(false);
          }
        });
        window.addEventListener('resize', function () {
          if (window.innerWidth >= 768) setMenu(false);
        });
      })();
    </script>
    
    <!-- Cookie consent banner -->
    <div id="cookie-banner" role="dialog" aria-modal="false" aria-label="Cookie consent" class="fixed bottom-0 inset-x-0 z-[100] hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-4">
        <div class="bg-carbon-900 border border-carbon-700 rounded-2xl shadow-2xl p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center gap-4">
          <div class="flex-1">
            <p class="text-sm text-gray-300">
              We use cookies and analytics to improve your experience and understand how our site is used. We never sell your data.
              <a href="/privacy" class="text-brand-500 underline underline-offset-2 hover:no-underline">Privacy Policy</a>
            </p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <button id="cookie-decline" class="px-4 py-2 rounded-xl text-sm font-medium text-gray-300 border border-carbon-600 hover:bg-carbon-800 transition-colors">Decline</button>
            <button id="cookie-accept" class="px-5 py-2 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-red-700 transition-colors">Accept</button>
          </div>
        </div>
      </div>
    </div>
    
    <script>
      (function () {
        var banner = document.getElementById('cookie-banner');
        var ACCEPT = 'accepted', DECLINE = 'declined';
        var stored = null;
        try { stored = localStorage.getItem('prm-consent'); } catch (e) {}
        if (!stored) { banner.style.display = 'block'; banner.classList.remove('hidden'); }
        
        document.getElementById('cookie-accept')?.addEventListener('click', function () {
          try { localStorage.setItem('prm-consent', ACCEPT); } catch (e) {}
          banner.remove();
          if (window.gtagConsent) window.gtagConsent(true);
        });
        document.getElementById('cookie-decline')?.addEventListener('click', function () {
          try { localStorage.setItem('prm-consent', DECLINE); } catch (e) {}
          banner.remove();
        });
      })();
    </script>
  </body>
</html>
